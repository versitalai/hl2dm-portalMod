// HL2DM Portal settings, shown in Options > Multiplayer > Advanced.
// The same settings are console variables (cl_portal_*); see README.
VERSION 1.0

DESCRIPTION CLIENT_OPTIONS
{
	"cl_portal_quality"
	{
		"Portal quality"
		{
			LIST
			"Auto (keeps the frame rate up)" "4"
			"High" "3"
			"Medium" "2"
			"Low" "1"
			"Off (solid portals, fastest)" "0"
		}
		{ "4" }
	}

	"cl_portal_auto_fps"
	{
		"Auto: frame rate to keep"
		{
			LIST
			"30" "30"
			"45" "45"
			"60" "60"
			"75" "75"
			"120" "120"
			"144" "144"
		}
		{ "60" }
	}

	"cl_portal_resolution"
	{
		"Portal view resolution (max)"
		{
			LIST
			"100%" "1"
			"75%" "0.75"
			"50%" "0.5"
			"25% (fastest)" "0.25"
		}
		{ "1" }
	}

	"cl_portal_draw_local_player"
	{
		"See yourself in portals"
		{ BOOL }
		{ "1" }
	}
}
