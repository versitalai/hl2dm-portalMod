+static void PortalHoldFailed( CBasePlayer *pPlayer, CWeaponPhysCannon *pCannon )
+{
+	// Only when the portal chain gets deeper than we track.
+	if ( pCannon )
+		pCannon->ForceDrop();
+	else
+		pPlayer->ForceDropOfCarriedPhysObjects( NULL );
