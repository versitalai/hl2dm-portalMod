+}
+
+// Screen bounds of a portal in normalized device coordinates (-1..1).
+struct HL2MPPortalScreenRect_t
+{
+	float flMinX, flMinY, flMaxX, flMaxY;
+};
+
+// Is any part of the portal inside the view frustum?
+static bool HL2MPPortal_IsOnScreen( C_HL2MPPortal *pPortal, const VMatrix &matWorldToProjection, const Vector &vViewOrigin, HL2MPPortalScreenRect_t *pRect )
+{
+	Vector vForward, vRight, vUp;
+	pPortal->GetPortalVectors( &vForward, &vRight, &vUp );
+
+	HL2MPPortalScreenRect_t full = { -1.0f, -1.0f, 1.0f, 1.0f };
+	*pRect = full;
+
+	// Close enough to touch: always visible (corners may be behind the camera).
+	if ( ( vViewOrigin - pPortal->GetAbsOrigin() ).LengthSqr() < 96.0f * 96.0f )
+		return true;
+
+	float flMinX = FLT_MAX, flMinY = FLT_MAX, flMaxX = -FLT_MAX, flMaxY = -FLT_MAX;
+	for ( int i = 0; i < 4; i++ )
+	{
+		Vector vCorner = pPortal->GetAbsOrigin() +
+			vRight * ( ( i & 1 ) ? HL2MP_PORTAL_HALF_WIDTH : -HL2MP_PORTAL_HALF_WIDTH ) +
+			vUp * ( ( i & 2 ) ? HL2MP_PORTAL_HALF_HEIGHT : -HL2MP_PORTAL_HALF_HEIGHT );
+
+		Vector4D vClip;
+		matWorldToProjection.V4Mul( Vector4D( vCorner.x, vCorner.y, vCorner.z, 1.0f ), vClip );
+		if ( vClip.w <= 0.0f )
+		{
+			// A corner behind the camera: can't bound it in screen space, assume visible.
+			return true;
+		}
+
+		float flX = vClip.x / vClip.w;
+		float flY = vClip.y / vClip.w;
+		flMinX = MIN( flMinX, flX ); flMaxX = MAX( flMaxX, flX );
+		flMinY = MIN( flMinY, flY ); flMaxY = MAX( flMaxY, flY );
+	}
+
+	pRect->flMinX = MAX( flMinX, -1.0f ); pRect->flMaxX = MIN( flMaxX, 1.0f );
+	pRect->flMinY = MAX( flMinY, -1.0f ); pRect->flMaxY = MIN( flMaxY, 1.0f );
+	return flMaxX >= -1.0f && flMinX <= 1.0f && flMaxY >= -1.0f && flMinY <= 1.0f;
+}
+
+// Pixel rect (left, top, right, bottom) of a screen rect in a view, padded for
+// bilinear filtering at the edges.
+static void HL2MPPortal_RectToPixels( const HL2MPPortalScreenRect_t &rect, const CViewSetup &view, int *pPixels )
+{
+	pPixels[0] = clamp( (int)( ( 0.5f + 0.5f * rect.flMinX ) * view.width ) - 2, 0, view.width );
+	pPixels[1] = clamp( (int)( ( 0.5f - 0.5f * rect.flMaxY ) * view.height ) - 2, 0, view.height );
+	pPixels[2] = clamp( (int)( ( 0.5f + 0.5f * rect.flMaxX ) * view.width ) + 3, 0, view.width );
+	pPixels[3] = clamp( (int)( ( 0.5f - 0.5f * rect.flMinY ) * view.height ) + 3, 0, view.height );
+}
+
+// Open, front-facing portals visible in a view, closest first. If pClipPortal
+// is set (the exit portal the view looks out of), portals behind its plane
+// and the clip portal itself are left out.
+static void HL2MPPortal_FindVisible( const CViewSetup &view, const VMatrix &matWorldToProjection, C_HL2MPPortal *pClipPortal, int nMax, float flMinScreen,
+	CUtlVector<C_HL2MPPortal *> &visible, CUtlVector<HL2MPPortalScreenRect_t> &rects )
+{
+	CUtlVector<float> distances;
+	visible.RemoveAll();
+	rects.RemoveAll();
+
+	for ( int i = 0; i < C_HL2MPPortal::GetPortalCount(); i++ )
+	{
+		C_HL2MPPortal *pPortal = C_HL2MPPortal::GetPortal( i );
+		if ( pPortal == pClipPortal || !pPortal->IsOpen() || pPortal->IsDormant() || pPortal->GetLinkedPortal()->IsDormant() )
+			continue;
+
+		if ( pClipPortal && DotProduct( pClipPortal->GetSurfaceNormal(), pPortal->GetAbsOrigin() - pClipPortal->GetAbsOrigin() ) <= 0.0f )
+			continue;
+
+		// In front, or just behind it in the hole (walking through: the view
+		// keeps going while the camera is in the tunnel behind the surface).
+		Vector vToView = view.origin - pPortal->GetAbsOrigin();
+		float flViewDist = DotProduct( vToView, pPortal->GetSurfaceNormal() );
+		if ( flViewDist <= 0.0f && ( pClipPortal || flViewDist < -pPortal->GetTunnelDepth() ||
+			!pPortal->IsPointInEllipse( view.origin - pPortal->GetSurfaceNormal() * flViewDist ) ) )
+			continue;
+
+		HL2MPPortalScreenRect_t rect;
+		if ( !HL2MPPortal_IsOnScreen( pPortal, matWorldToProjection, view.origin, &rect ) )
+			continue;
+
+		// Too small on screen to be worth a whole extra view: draw it solid.
+		if ( MAX( rect.flMaxX - rect.flMinX, rect.flMaxY - rect.flMinY ) * 0.5f < flMinScreen )
+			continue;
+
+		float flDist = vToView.LengthSqr();
+		int iInsert = 0;
+		while ( iInsert < distances.Count() && distances[iInsert] < flDist )
+			iInsert++;
+		visible.InsertBefore( iInsert, pPortal );
+		rects.InsertBefore( iInsert, rect );
+		distances.InsertBefore( iInsert, flDist );
+	}
+
+	while ( visible.Count() > nMax )
+	{
+		visible.RemoveMultipleFromTail( 1 );
+		rects.RemoveMultipleFromTail( 1 );
+	}
+}
+
+// The parent view's camera carried through pPortal (same FOV and size).
+static CViewSetup HL2MPPortal_VirtualView( C_HL2MPPortal *pPortal, const CViewSetup &parentView )
+{
+	VMatrix matToLinked = pPortal->MatrixThisToLinked();
+	VMatrix matCamera, matVirtual;
+	matCamera.SetupMatrixOrgAngles( parentView.origin, parentView.angles );
+	matVirtual = matToLinked * matCamera;
+
+	CViewSetup portalView = parentView;
+	portalView.x = 0;
+	portalView.y = 0;
+	portalView.origin = matToLinked.VMul4x3( parentView.origin );
+	MatrixAngles( matVirtual.As3x4(), portalView.angles );
+	portalView.m_bDoBloomAndToneMapping = false;
+	return portalView;
+}
+
+static ITexture *HL2MPPortal_GetRenderTarget( int iSlot )
+{
+	static CTextureReference s_RenderTargets[HL2MP_PORTAL_MAX_VIEWS];
+	if ( iSlot < 0 || iSlot >= HL2MP_PORTAL_MAX_VIEWS )
+		return NULL;
+
+	if ( !s_RenderTargets[iSlot].IsValid() )
+	{
+		s_RenderTargets[iSlot].Init( materials->FindTexture( HL2MPPortal_GetRenderTargetName( iSlot ), TEXTURE_GROUP_RENDER_TARGET ) );
+	}
+
+	ITexture *pRenderTarget = s_RenderTargets[iSlot];
+	if ( !pRenderTarget || pRenderTarget->IsError() )
+		return NULL;
+	return pRenderTarget;
+}
+
+void CViewRender::RenderHL2MPPortalView( C_HL2MPPortal *pPortal, const CViewSetup &parentView, ITexture *pRenderTarget, int iDepth, const HL2MPPortalScreenRect_t &rect )
+{
+	C_HL2MPPortal *pLinked = pPortal->GetLinkedPortal();
+	CViewSetup portalView = HL2MPPortal_VirtualView( pPortal, parentView );
+
+	// World vis from just in front of the exit, not from the camera (which is behind the wall).
+	Vector vExitNormal = pLinked->GetSurfaceNormal();
+	ViewCustomVisibility_t customVis;
+	customVis.AddVisOrigin( pLinked->GetAbsOrigin() + vExitNormal * 8.0f );
+
+	int iOldDepth = g_iHL2MPPortalRenderDepth;
+	g_iHL2MPPortalRenderDepth = iDepth;
+	g_bRenderingHL2MPPortalView = true;
+
+	Frustum frustum;
+	render->Push3DView( portalView, VIEW_CLEAR_DEPTH | VIEW_CLEAR_COLOR, pRenderTarget, (VPlane *)frustum );
+
+	// Only draw what's in front of the exit portal, and only the pixels the
+	// portal covers in the parent view (the rest of the target is never sampled).
+	Vector4D vClipPlane;
+	vClipPlane.AsVector3D() = vExitNormal;
+	vClipPlane.w = DotProduct( vExitNormal, pLinked->GetAbsOrigin() ) + 0.5f;
+	bool bScissor = cl_portal_scissor.GetBool();
+	{
+		CMatRenderContextPtr pRenderContext( materials );
+		pRenderContext->PushCustomClipPlane( vClipPlane.Base() );
+		if ( bScissor )
+		{
+			int pixels[4];
+			HL2MPPortal_RectToPixels( rect, portalView, pixels );
+			pRenderContext->SetScissorRect( pixels[0], pixels[1], pixels[2], pixels[3], true );
+		}
+	}
+
+	ViewDrawScene( false, SKYBOX_2DSKYBOX_VISIBLE, portalView, 0, VIEW_MONITOR, false, 0, &customVis );
+
+	// In first person the local player isn't in the render lists; draw them
+	// explicitly so you can see yourself through the portal.
+	C_BasePlayer *pLocalPlayer = C_BasePlayer::GetLocalPlayer();
+	if ( cl_portal_draw_local_player.GetBool() && pLocalPlayer && pLocalPlayer->IsAlive() && !C_BasePlayer::ShouldDrawLocalPlayer() )
+	{
+		pLocalPlayer->DrawModel( STUDIO_RENDER );
+	}
+
+	{
+		CMatRenderContextPtr pRenderContext( materials );
+		if ( bScissor )
+		{
+			pRenderContext->SetScissorRect( 0, 0, 0, 0, false );
+		}
+		pRenderContext->PopCustomClipPlane();
+	}
+	render->PopView( frustum );
+
+	g_iHL2MPPortalRenderDepth = iOldDepth;
+	g_bRenderingHL2MPPortalView = ( iOldDepth > 0 );
+}
+
+void CViewRender::DrawHL2MPPortalViews( const CViewSetup &mainView )
+{
+	// A new frame: views rendered last frame are stale, whether or not any
+	// get rendered now. (Bumped only when views were drawn, a portal whose
+	// views stopped, e.g. auto dropping to off or recursion turned off, kept
+	// showing its last image, frozen.)
+	for ( int i = 0; i < HL2MP_PORTAL_MAX_DEPTH; i++ )
+	{
+		g_iHL2MPPortalViewStamp[i]++;
+	}
+
+	bool bRendered = false;
+	if ( cl_portal_render_views.GetBool() && C_HL2MPPortal::GetPortalCount() > 0 )
+	{
+		int iLevel = HL2MPPortal_GetQualityLevel();
+		const HL2MPPortalQuality_t &quality = s_HL2MPPortalQuality[iLevel];
+		s_bHL2MPPortalCheapWater = ( iLevel < HL2MP_PORTAL_QUALITY_TOP );
+		int nViews = MIN( MIN( quality.nViews, cl_portal_max_views.GetInt() ), HL2MP_PORTAL_MAX_PRIMARY_VIEWS );
+		float flResolution = clamp( MIN( quality.flResolution, cl_portal_resolution.GetFloat() ), 0.25f, 1.0f );
+		if ( nViews > 0 )
+		{
+			bRendered = DrawHL2MPPortalViewsAtQuality( mainView, nViews, quality.bRecursion && cl_portal_recursion.GetBool(),
+				flResolution, quality.flMinScreen );
+		}
+		s_pszPortalLastLevel = quality.pszName;
+		s_nPortalLastViews = nViews;
+		s_flPortalLastResolution = flResolution;
+	}
+	else
+	{
+		s_pszPortalLastLevel = cl_portal_render_views.GetBool() ? "no portals open" : "off";
+		s_nPortalLastViews = 0;
+		// Keep auto's frame time average current while nothing is drawn.
+		HL2MPPortal_GetQualityLevel();
+	}
+	s_bPortalViewsRendered = bRendered;
+}
+
+bool CViewRender::DrawHL2MPPortalViewsAtQuality( const CViewSetup &mainView, int nViews, bool bRecursion, float flResolution, float flMinScreen )
+{
+	VMatrix matWorldToView, matViewToProjection, matWorldToPixels;
+	render->GetMatricesForView( mainView, &matWorldToView, &matViewToProjection, &g_matHL2MPPortalWorldToProjection[0], &matWorldToPixels );
+
+	// Portal views are rendered at a fraction of the screen's size (into the top
+	// left of their target) with the same projection, so screen positions and
+	// the portal's screen-space texture mapping stay the same, just scaled.
+	flResolution = clamp( flResolution, 0.25f, 1.0f );
+	CViewSetup scaledView = mainView;
+	scaledView.x = 0;
+	scaledView.y = 0;
+	scaledView.width = MAX( 16, (int)( mainView.width * flResolution ) );
+	scaledView.height = MAX( 16, (int)( mainView.height * flResolution ) );
+	scaledView.m_flAspectRatio = ( mainView.m_flAspectRatio > 0.0f ) ? mainView.m_flAspectRatio : (float)mainView.width / (float)mainView.height;
+
+	CUtlVector<C_HL2MPPortal *> primary;
+	CUtlVector<HL2MPPortalScreenRect_t> primaryRects;
+	HL2MPPortal_FindVisible( mainView, g_matHL2MPPortalWorldToProjection[0], NULL, nViews, flMinScreen, primary, primaryRects );
+
+	int nRendered = 0;
+	for ( int iPrimary = 0; iPrimary < primary.Count(); iPrimary++ )
+	{
+		ITexture *pRenderTarget = HL2MPPortal_GetRenderTarget( iPrimary );
+		if ( !pRenderTarget )
+			break;
+
+		// The portal samples the target in its parent view's screen space; all
+		// views share the scaled size.
+		g_flHL2MPPortalUScale = (float)scaledView.width / pRenderTarget->GetActualWidth();
+		g_flHL2MPPortalVScale = (float)scaledView.height / pRenderTarget->GetActualHeight();
+
+		C_HL2MPPortal *pPortal = primary[iPrimary];
+
+		// Portals visible inside this portal's view get their own views first,
+		// so they show live too instead of a flat color.
+		if ( bRecursion )
+		{
+			CViewSetup portalView = HL2MPPortal_VirtualView( pPortal, scaledView );
+			render->GetMatricesForView( portalView, &matWorldToView, &matViewToProjection, &g_matHL2MPPortalWorldToProjection[1], &matWorldToPixels );
+			g_iHL2MPPortalViewStamp[1]++;
+
+			CUtlVector<C_HL2MPPortal *> nested;
+			CUtlVector<HL2MPPortalScreenRect_t> nestedRects;
+			HL2MPPortal_FindVisible( portalView, g_matHL2MPPortalWorldToProjection[1], pPortal->GetLinkedPortal(), HL2MP_PORTAL_MAX_NESTED_VIEWS, flMinScreen, nested, nestedRects );
+
+			for ( int iNested = 0; iNested < nested.Count(); iNested++ )
+			{
+				int iSlot = HL2MP_PORTAL_MAX_PRIMARY_VIEWS + iNested;
+				ITexture *pNestedTarget = HL2MPPortal_GetRenderTarget( iSlot );
+				if ( !pNestedTarget )
+					break;
+
+				RenderHL2MPPortalView( nested[iNested], portalView, pNestedTarget, 2, nestedRects[iNested] );
+				nested[iNested]->m_iViewSlot[1] = iSlot;
+				nested[iNested]->m_iViewStamp[1] = g_iHL2MPPortalViewStamp[1];
+			}
+		}
+
+		RenderHL2MPPortalView( pPortal, scaledView, pRenderTarget, 1, primaryRects[iPrimary] );
+		pPortal->m_iViewSlot[0] = iPrimary;
+		pPortal->m_iViewStamp[0] = g_iHL2MPPortalViewStamp[0];
+		nRendered++;
+	}
+	return nRendered > 0;
+}
