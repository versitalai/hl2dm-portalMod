+bool CGrabController::TransformThroughPortals( Vector *pPosition, QAngle *pAngles, Vector *pDirection ) const
+{
+	for ( int i = 0; i < m_nPortals; i++ )
+	{
+		CHL2MPPortal *pPortal = m_hPortals[i];
+		if ( !pPortal || !pPortal->IsOpen() )
+			return false;
+
+		VMatrix matToLinked = pPortal->MatrixThisToLinked();
+		if ( pPosition )
+		{
+			*pPosition = matToLinked.VMul4x3( *pPosition );
+		}
+		if ( pDirection )
+		{
+			*pDirection = matToLinked.VMul3x3( *pDirection );
+		}
+		if ( pAngles )
+		{
+			VMatrix matAngles, matResult;
+			matAngles.SetupMatrixOrgAngles( vec3_origin, *pAngles );
+			matResult = matToLinked * matAngles;
+			MatrixAngles( matResult.As3x4(), *pAngles );
+		}
+	}
+	return true;
+}
+
+bool CGrabController::OnAttachedWentThroughPortal( CHL2MPPortal *pPortal )
+{
+	// Move the current target with the object, so the controller doesn't pull
+	// it straight back through for a tick before the next UpdateObject.
+	VMatrix matToLinked = pPortal->MatrixThisToLinked();
+	VMatrix matRotation, matResult;
+	matRotation.SetupMatrixOrgAngles( vec3_origin, m_shadow.targetRotation );
+	matResult = matToLinked * matRotation;
+	m_shadow.targetPosition = matToLinked.VMul4x3( m_shadow.targetPosition );
+	MatrixAngles( matResult.As3x4(), m_shadow.targetRotation );
+
+	// Coming back the way it went: one portal fewer in between.
+	if ( m_nPortals > 0 && m_hPortals[m_nPortals - 1] == pPortal->GetLinkedPortal() )
+	{
+		m_nPortals--;
+		return true;
+	}
+
+	if ( m_nPortals >= HL2MP_PORTAL_MAX_RECURSION )
+		return false;
+
+	m_hPortals[m_nPortals++] = pPortal;
+	return true;
+}
+
+bool CGrabController::OnHolderWentThroughPortal( CHL2MPPortal *pPortal )
+{
+	// Holder followed the object through the first portal: one fewer.
+	if ( m_nPortals > 0 && m_hPortals[0] == pPortal )
+	{
+		for ( int i = 1; i < m_nPortals; i++ )
+		{
+			m_hPortals[i - 1] = m_hPortals[i];
+		}
+		m_nPortals--;
+		return true;
+	}
+
+	// Holder went elsewhere: the way back to the object is through the exit.
+	if ( m_nPortals >= HL2MP_PORTAL_MAX_RECURSION )
+		return false;
+
+	for ( int i = m_nPortals; i > 0; i-- )
+	{
+		m_hPortals[i] = m_hPortals[i - 1];
+	}
+	m_hPortals[0] = pPortal->GetLinkedPortal();
+	m_nPortals++;
+	return true;
+}
