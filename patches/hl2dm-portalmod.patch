+#ifdef HL2MP
+void CHL2GameMovement::TracePlayerBBox( const Vector& start, const Vector& end, unsigned int fMask, int collisionGroup, trace_t& pm )
+{
+	if ( !UTIL_HL2MPPortal_TracePlayerHull( start, end, GetPlayerMins(), GetPlayerMaxs(), fMask, mv->m_nPlayerHandle.Get(), collisionGroup, pm ) )
+	{
+		BaseClass::TracePlayerBBox( start, end, fMask, collisionGroup, pm );
+	}
+}
+
+void CHL2GameMovement::TryTouchGround( const Vector& start, const Vector& end, const Vector& mins, const Vector& maxs, unsigned int fMask, int collisionGroup, trace_t& pm )
+{
+	if ( !UTIL_HL2MPPortal_TracePlayerHull( start, end, mins, maxs, fMask, mv->m_nPlayerHandle.Get(), collisionGroup, pm ) )
+	{
+		BaseClass::TryTouchGround( start, end, mins, maxs, fMask, collisionGroup, pm );
+	}
+}
+
+CBaseHandle CHL2GameMovement::TestPlayerPosition( const Vector& pos, int collisionGroup, trace_t& pm )
+{
+	if ( !UTIL_HL2MPPortal_TracePlayerHull( pos, pos, GetPlayerMins(), GetPlayerMaxs(), PlayerSolidMask(), mv->m_nPlayerHandle.Get(), collisionGroup, pm ) )
+	{
+		return BaseClass::TestPlayerPosition( pos, collisionGroup, pm );
+	}
+
+	if ( ( pm.startsolid || pm.allsolid ) && ( pm.contents & PlayerSolidMask() ) && pm.m_pEnt )
+	{
+		return pm.m_pEnt->GetRefEHandle();
+	}
+	return INVALID_EHANDLE;
+}
+
+// Floor portals launch you at least this fast, so walking into a wall portal
+// whose partner is on the floor doesn't drop you straight back in.
+#define PORTAL_MIN_UPWARD_EXIT_SPEED	250.0f
+
+#ifdef GAME_DLL
+ConVar sv_portal_debug_moves( "sv_portal_debug_moves", "0", FCVAR_NONE, "Log each player portal transition, and blasts going through portals, to the console." );
+#endif
+
+void CHL2GameMovement::PlayerMove( void )
+{
+	// Heading into a portal a little off-center: slide over so the hull lines
+	// up with the hole instead of catching its rim.
+	if ( player->GetMoveType() == MOVETYPE_WALK )
+	{
+		Vector vecFunnel = UTIL_HL2MPPortal_PlayerFunnelMove( mv->GetAbsOrigin(), GetPlayerMins(), GetPlayerMaxs(), mv->m_vecVelocity, gpGlobals->frametime );
+		if ( vecFunnel != vec3_origin )
+		{
+			trace_t tr;
+			TracePlayerBBox( mv->GetAbsOrigin(), mv->GetAbsOrigin() + vecFunnel, PlayerSolidMask(), COLLISION_GROUP_PLAYER_MOVEMENT, tr );
+			if ( !tr.startsolid )
+			{
+				mv->SetAbsOrigin( tr.endpos );
+			}
+		}
+	}
+
+	Vector vecOriginStart = mv->GetAbsOrigin();
+	Vector vecEyeStart = vecOriginStart + player->GetViewOffset();
+	Vector vecVelocityStart = mv->m_vecVelocity;
+
+	BaseClass::PlayerMove();
+
+	if ( player->GetMoveType() != MOVETYPE_WALK )
+		return;
+
+	Vector vecEye = mv->GetAbsOrigin() + player->GetViewOffset();
+	CHL2MPPortal *pPortal = UTIL_HL2MPPortal_FindPlayerTransition( mv->GetAbsOrigin(), GetPlayerMins(), GetPlayerMaxs(), vecEyeStart, vecEye );
+
+	// Going in fast and stopped dead inside the hole: the part already through
+	// hit something in front of the exit before the eye got to the plane
+	// (feet first into a floor portal that comes out of a wall, the feet stick
+	// out of the wall up to a body length ahead). Go through now, at the speed
+	// it came in with, and meet that obstacle on the other side instead of
+	// hanging in the hole.
+	bool bForced = false;
+	if ( !pPortal )
+	{
+		pPortal = UTIL_HL2MPPortal_FindBlockedEntry( mv->GetAbsOrigin(), GetPlayerMins(), GetPlayerMaxs(), vecVelocityStart, mv->m_vecVelocity );
+		if ( !pPortal )
+			return;
+		bForced = true;
+		mv->m_vecVelocity = vecVelocityStart;
+	}
+
+	CHL2MPPortal *pLinked = pPortal->GetLinkedPortal();
+	VMatrix matToLinked = pPortal->MatrixThisToLinked();
+
+	// The hull never rotates. Carry the eye through and rebuild the origin from
+	// it, so the camera is continuous even between a floor and a wall portal
+	// (carrying the hull's center would jump the camera there). Do it at the
+	// moment the eye was on the plane, then finish this tick's move on the
+	// exit side: mapping the end of the move instead leaves the hull too deep
+	// in the exit, and pushing it out gained height every loop between two
+	// floor portals.
+	Vector vecViewOffset = player->GetViewOffset();
+	int k;
+	float flSign, flDist;
+	pPortal->GetPlaneAxis( &k, &flSign, &flDist );
+	float flEyeStart = flSign * ( vecEyeStart[k] - flDist );
+	float flEyeEnd = flSign * ( vecEye[k] - flDist );
+	float flCross = ( flEyeStart - flEyeEnd > 0.001f ) ? clamp( flEyeStart / ( flEyeStart - flEyeEnd ), 0.0f, 1.0f ) : 1.0f;
+	Vector vecCross = vecOriginStart + ( mv->GetAbsOrigin() - vecOriginStart ) * flCross;
+	Vector vecOrigin = matToLinked.VMul4x3( vecCross + vecViewOffset ) - vecViewOffset;
+	Vector vecRestOfMove = matToLinked.VMul3x3( mv->GetAbsOrigin() - vecCross );
+
+	Vector vecVelocity = matToLinked.VMul3x3( mv->m_vecVelocity );
+
+	// The part of the tick after the crossing ran with gravity on the entry
+	// side; on the exit side it pulls the other way (between floor portals it
+	// sped the fall up where it should slow the climb). Redo that gravity in
+	// the exit frame, or every loop gains one tick of speed.
+	if ( player->GetGroundEntity() == NULL && player->GetWaterLevel() < WL_Waist )
+	{
+		float flGravity = ( player->GetGravity() ? player->GetGravity() : 1.0f ) * GetCurrentGravity();
+		Vector vecGravityAfter( 0.0f, 0.0f, -flGravity * ( 1.0f - flCross ) * gpGlobals->frametime );
+		vecVelocity += vecGravityAfter - matToLinked.VMul3x3( vecGravityAfter );
+	}
+
+	Vector vecExitNormal = pLinked->GetSurfaceNormal();
+	Vector vecWanted = vecOrigin + vecRestOfMove;
+
+	// If the hull can't sit there (doesn't fit the exit hole), move it out of
+	// the exit only as far as it takes, so the camera barely moves.
+	trace_t tr;
+	const char *pszExit = "direct";
+	if ( TestPlayerPosition( vecOrigin, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) == INVALID_EHANDLE )
+	{
+		if ( vecRestOfMove.LengthSqr() > 0.0001f )
+		{
+			TracePlayerBBox( vecOrigin, vecOrigin + vecRestOfMove, PlayerSolidMask(), COLLISION_GROUP_PLAYER_MOVEMENT, tr );
+			if ( !tr.startsolid )
+			{
+				vecOrigin = tr.endpos;
+			}
+		}
+	}
+	else
+	{
+		Vector vecMid = ( GetPlayerMins() + GetPlayerMaxs() ) * 0.5f;
+		Vector vecHalf = ( GetPlayerMaxs() - GetPlayerMins() ) * 0.5f;
+
+		// First line the hull up with the exit hole: from a floor portal into a
+		// wall one the eye lands on the plane with the feet below the hole's
+		// bottom edge (in the floor), which no push straight out can fix; that
+		// left the player stuck and stopped dead.
+		Vector vecShift;
+		pszExit = "pushed out";
+		if ( pLinked->GetHoleFitShift( vecOrigin + vecMid, vecHalf, &vecShift, -0.1f ) && vecShift.LengthSqr() > 0.0001f )
+		{
+			vecOrigin += vecShift;
+			pszExit = "lined up";
+		}
+
+		float flExtent = fabs( vecExitNormal.x ) * vecHalf.x + fabs( vecExitNormal.y ) * vecHalf.y + fabs( vecExitNormal.z ) * vecHalf.z;
+		float flDepth = DotProduct( vecExitNormal, vecOrigin + vecMid - pLinked->GetAbsOrigin() );
+		float flFullOut = flExtent + 1.0f - flDepth;
+
+		// Out of the exit, and up a step if need be (the floor in front of a
+		// wall portal can be a little higher than the hole's bottom edge).
+		Vector vecOut = vecOrigin + vecExitNormal * MAX( flFullOut, 0.0f );
+		bool bFound = false;
+		for ( float flOut = 0.0f; flOut < flFullOut + 2.0f && !bFound; flOut += 2.0f )
+		{
+			for ( float flUp = 0.0f; flUp <= player->m_Local.m_flStepSize && !bFound; flUp += 2.0f )
+			{
+				Vector vecTry = vecOrigin + vecExitNormal * MIN( flOut, MAX( flFullOut, 0.0f ) ) + Vector( 0.0f, 0.0f, flUp );
+				if ( TestPlayerPosition( vecTry, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) == INVALID_EHANDLE )
+				{
+					vecOut = vecTry;
+					bFound = true;
+				}
+			}
+		}
+		vecOrigin = vecOut;
+		if ( TestPlayerPosition( vecOrigin, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) != INVALID_EHANDLE )
+		{
+			pszExit = "STUCK";
+		}
+
+		if ( vecRestOfMove.LengthSqr() > 0.0001f && TestPlayerPosition( vecOrigin, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) == INVALID_EHANDLE )
+		{
+			TracePlayerBBox( vecOrigin, vecOrigin + vecRestOfMove, PlayerSolidMask(), COLLISION_GROUP_PLAYER_MOVEMENT, tr );
+			if ( !tr.startsolid )
+			{
+				vecOrigin = tr.endpos;
+			}
+		}
+	}
+
+	// Never leave the camera behind the exit (a forced crossing maps an eye
+	// that hadn't reached the plane yet): move out until it's in front.
+	float flEyeBehind = -DotProduct( vecOrigin + vecViewOffset - pLinked->GetAbsOrigin(), vecExitNormal );
+	if ( flEyeBehind > 0.0f )
+	{
+		Vector vecTry = vecOrigin + vecExitNormal * ( flEyeBehind + 1.0f );
+		if ( TestPlayerPosition( vecTry, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) == INVALID_EHANDLE )
+		{
+			vecOrigin = vecTry;
+		}
+	}
+
+	// Being pushed up out of a floor exit must not add energy: take the height
+	// it gained out of the outward speed.
+	float flRise = vecOrigin.z - vecWanted.z;
+	float flOutSpeed = DotProduct( vecVelocity, vecExitNormal );
+	if ( vecExitNormal.z > 0.7f && flRise > 0.0f && flOutSpeed > 0.0f )
+	{
+		float flNewOut = sqrtf( MAX( flOutSpeed * flOutSpeed - 2.0f * GetCurrentGravity() * flRise, 0.0f ) );
+		vecVelocity += vecExitNormal * ( flNewOut - flOutSpeed );
+	}
+
+	if ( vecExitNormal.z > 0.7f )
+	{
+		float flOut = DotProduct( vecVelocity, vecExitNormal );
+		if ( flOut < PORTAL_MIN_UPWARD_EXIT_SPEED )
+		{
+			vecVelocity += vecExitNormal * ( PORTAL_MIN_UPWARD_EXIT_SPEED - flOut );
+		}
+	}
+
+	// View turns with the portal; roll dropped.
+	QAngle angViewBefore = mv->m_vecViewAngles;
+	Vector vecForward;
+	AngleVectors( mv->m_vecViewAngles, &vecForward );
+	QAngle angView;
+	VectorAngles( matToLinked.VMul3x3( vecForward ), angView );
+	angView.x = clamp( AngleNormalize( angView.x ), -89.0f, 89.0f );
+	angView.z = 0.0f;
+
+#ifdef GAME_DLL
+	if ( sv_portal_debug_moves.GetBool() )
+	{
+		Msg( "PORTALTEST move t=%.3f eye %.1f -> %.1f cross %.2f z %.1f -> %.1f (wanted %.1f) vz %.0f -> %.0f, exit %s%s at (%.1f %.1f %.1f) vel (%.0f %.0f %.0f)\n",
+			gpGlobals->curtime, flEyeStart, flEyeEnd, flCross, mv->GetAbsOrigin().z, vecOrigin.z, vecWanted.z,
