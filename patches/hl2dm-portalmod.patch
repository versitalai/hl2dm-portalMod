+static CGrabController *GetPlayerGrabController( CBasePlayer *pPlayer, CWeaponPhysCannon **ppCannon )
+{
+	*ppCannon = NULL;
+
+	CPlayerPickupController *pPickup = dynamic_cast<CPlayerPickupController *>( pPlayer->GetUseEntity() );
