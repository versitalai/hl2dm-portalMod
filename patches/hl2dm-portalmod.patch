+void CHL2GameMovement::PlayerMove( void )
+{
+	// Heading into a portal a little off-center: slide over so the hull lines
+	// up with the hole instead of catching its rim.
+	if ( player->GetMoveType() == MOVETYPE_WALK )
+	{
+		Vector vecFunnel = UTIL_HL2MPPortal_PlayerFunnelMove( mv->GetAbsOrigin(), GetPlayerMins(), GetPlayerMaxs(), mv->m_vecVelocity, gpGlobals->frametime );
+		if ( vecFunnel != vec3_origin )
+		{
+			trace_t tr;
+			TracePlayerBBox( mv->GetAbsOrigin(), mv->GetAbsOrigin() + vecFunnel, PlayerSolidMask(), COLLISION_GROUP_PLAYER_MOVEMENT, tr );
+			if ( !tr.startsolid )
+			{
+				mv->SetAbsOrigin( tr.endpos );
+			}
+		}
+	}
+
+	Vector vecOriginStart = mv->GetAbsOrigin();
+	Vector vecEyeStart = vecOriginStart + player->GetViewOffset();
+
+	BaseClass::PlayerMove();
+
+	if ( player->GetMoveType() != MOVETYPE_WALK )
+		return;
+
+	Vector vecEye = mv->GetAbsOrigin() + player->GetViewOffset();
+	CHL2MPPortal *pPortal = UTIL_HL2MPPortal_FindPlayerTransition( mv->GetAbsOrigin(), GetPlayerMins(), GetPlayerMaxs(), vecEyeStart, vecEye );
+	if ( !pPortal )
+		return;
+
+	CHL2MPPortal *pLinked = pPortal->GetLinkedPortal();
+	VMatrix matToLinked = pPortal->MatrixThisToLinked();
+
+	// The hull never rotates. Carry the eye through and rebuild the origin from
+	// it, so the camera is continuous even between a floor and a wall portal
+	// (carrying the hull's center would jump the camera there). Do it at the
+	// moment the eye was on the plane, then finish this tick's move on the
+	// exit side: mapping the end of the move instead leaves the hull too deep
+	// in the exit, and pushing it out gained height every loop between two
+	// floor portals.
+	Vector vecViewOffset = player->GetViewOffset();
+	int k;
+	float flSign, flDist;
+	pPortal->GetPlaneAxis( &k, &flSign, &flDist );
+	float flEyeStart = flSign * ( vecEyeStart[k] - flDist );
+	float flEyeEnd = flSign * ( vecEye[k] - flDist );
+	float flCross = ( flEyeStart - flEyeEnd > 0.001f ) ? clamp( flEyeStart / ( flEyeStart - flEyeEnd ), 0.0f, 1.0f ) : 1.0f;
+	Vector vecCross = vecOriginStart + ( mv->GetAbsOrigin() - vecOriginStart ) * flCross;
+	Vector vecOrigin = matToLinked.VMul4x3( vecCross + vecViewOffset ) - vecViewOffset;
+	Vector vecRestOfMove = matToLinked.VMul3x3( mv->GetAbsOrigin() - vecCross );
+
+	Vector vecVelocity = matToLinked.VMul3x3( mv->m_vecVelocity );
+	Vector vecExitNormal = pLinked->GetSurfaceNormal();
+	Vector vecWanted = vecOrigin + vecRestOfMove;
+
+	// If the hull can't sit there (doesn't fit the exit hole), move it out of
+	// the exit only as far as it takes, so the camera barely moves.
+	trace_t tr;
+	if ( TestPlayerPosition( vecOrigin, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) == INVALID_EHANDLE )
+	{
+		if ( vecRestOfMove.LengthSqr() > 0.0001f )
+		{
+			TracePlayerBBox( vecOrigin, vecOrigin + vecRestOfMove, PlayerSolidMask(), COLLISION_GROUP_PLAYER_MOVEMENT, tr );
+			if ( !tr.startsolid )
+			{
+				vecOrigin = tr.endpos;
+			}
+		}
+	}
+	else
+	{
+		Vector vecMid = ( GetPlayerMins() + GetPlayerMaxs() ) * 0.5f;
+		Vector vecHalf = ( GetPlayerMaxs() - GetPlayerMins() ) * 0.5f;
+		float flExtent = fabs( vecExitNormal.x ) * vecHalf.x + fabs( vecExitNormal.y ) * vecHalf.y + fabs( vecExitNormal.z ) * vecHalf.z;
+		float flDepth = DotProduct( vecExitNormal, vecOrigin + vecMid - pLinked->GetAbsOrigin() );
+		float flFullOut = flExtent + 1.0f - flDepth;
+
+		Vector vecOut = vecOrigin + vecExitNormal * MAX( flFullOut, 0.0f );
+		for ( float flOut = 2.0f; flOut < flFullOut; flOut += 2.0f )
+		{
+			Vector vecTry = vecOrigin + vecExitNormal * flOut;
+			if ( TestPlayerPosition( vecTry, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) == INVALID_EHANDLE )
+			{
+				vecOut = vecTry;
+				break;
+			}
+		}
+		vecOrigin = vecOut;
+	}
+
+	// Being pushed up out of the exit must not add energy: take the height
+	// it gained out of the outward speed, or two floor portals launch you a
+	// little higher every loop.
+	float flRise = vecOrigin.z - vecWanted.z;
+	float flOutSpeed = DotProduct( vecVelocity, vecExitNormal );
+	if ( flRise > 0.0f && flOutSpeed > 0.0f )
+	{
+		float flNewOut = sqrtf( MAX( flOutSpeed * flOutSpeed - 2.0f * GetCurrentGravity() * flRise, 0.0f ) );
+		vecVelocity += vecExitNormal * ( flNewOut - flOutSpeed );
+	}
+
+	if ( vecExitNormal.z > 0.7f )
+	{
+		float flOut = DotProduct( vecVelocity, vecExitNormal );
+		if ( flOut < PORTAL_MIN_UPWARD_EXIT_SPEED )
+		{
+			vecVelocity += vecExitNormal * ( PORTAL_MIN_UPWARD_EXIT_SPEED - flOut );
+		}
+	}
+
+	// View turns with the portal; roll dropped.
+	Vector vecForward;
+	AngleVectors( mv->m_vecViewAngles, &vecForward );
+	QAngle angView;
+	VectorAngles( matToLinked.VMul3x3( vecForward ), angView );
+	angView.x = clamp( AngleNormalize( angView.x ), -89.0f, 89.0f );
+	angView.z = 0.0f;
+
+#ifdef GAME_DLL
+	if ( sv_portal_debug_moves.GetBool() )
+	{
+		Msg( "PORTALTEST move t=%.3f eye %.1f -> %.1f cross %.2f z %.1f -> %.1f (wanted %.1f) vz %.0f -> %.0f\n",
+			gpGlobals->curtime, flEyeStart, flEyeEnd, flCross, mv->GetAbsOrigin().z, vecOrigin.z, vecWanted.z,
+			mv->m_vecVelocity.z, vecVelocity.z );
+	}
+#endif
+
+	mv->SetAbsOrigin( vecOrigin );
+	mv->m_vecVelocity = vecVelocity;
+	mv->m_vecViewAngles = angView;
+	mv->m_vecAbsViewAngles = angView;
+	mv->m_vecAngles = angView;
+	SetGroundEntity( NULL );
+
+#ifdef CLIENT_DLL
+	// Turn the local view once; repredicted commands already carry the new angles.
+	if ( prediction->IsFirstTimePredicted() && player->IsLocalPlayer() )
+	{
+		engine->SetViewAngles( angView );
+
+		// Don't blend the camera across the portal: drop any leftover
+		// prediction-error smoothing (an offset in the old side's frame), and
+		// reset position interpolation once the new origin is applied.
+		Vector vecSmooth;
+		player->GetPredictionErrorSmoothingVector( vecSmooth );
+		if ( vecSmooth != vec3_origin )
+		{
+			player->NotePredictionError( -vecSmooth );
+		}
+		static_cast<C_HL2MP_Player *>( player )->m_bPortalResetInterpolation = true;
+	}
+#else
+	player->SetLocalAngles( angView );
+	player->pl.v_angle = angView;
+	player->IncrementInterpolationFrame();
+
+	// Whatever they're holding stays held from the other side.
+	extern void PhysCannon_HolderWentThroughPortal( CBasePlayer *pPlayer, CHL2MPPortal *pPortal );
+	PhysCannon_HolderWentThroughPortal( player, pPortal );
+#endif
+}
