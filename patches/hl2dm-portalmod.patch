+CBaseHandle CHL2GameMovement::TestPlayerPosition( const Vector& pos, int collisionGroup, trace_t& pm )
+{
+	if ( !UTIL_HL2MPPortal_TracePlayerHull( pos, pos, GetPlayerMins(), GetPlayerMaxs(), PlayerSolidMask(), mv->m_nPlayerHandle.Get(), collisionGroup, pm ) )
+	{
+		return BaseClass::TestPlayerPosition( pos, collisionGroup, pm );
+	}
+
+	if ( ( pm.startsolid || pm.allsolid ) && ( pm.contents & PlayerSolidMask() ) && pm.m_pEnt )
+	{
+		return pm.m_pEnt->GetRefEHandle();
+	}
+	return INVALID_EHANDLE;
