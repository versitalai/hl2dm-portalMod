+//-----------------------------------------------------------------------------
+// Purpose: Partly through a portal, the wall behind the hole stops the physics
+//			shadow (VPhysics knows nothing of portals) and the base class's stuck
+//			checks use plain traces, so both would drag the player back out of
+//			the hole every tick. Game movement already collided correctly
+//			there; keep the shadow with the player instead.
+//-----------------------------------------------------------------------------
+void CHL2MP_Player::VPhysicsShadowUpdate( IPhysicsObject *pPhysics )
+{
+	trace_t tr;
+	if ( GetMoveType() == MOVETYPE_WALK && pPhysics &&
+		UTIL_HL2MPPortal_TracePlayerHull( GetAbsOrigin(), GetAbsOrigin(), CollisionProp()->OBBMins(), CollisionProp()->OBBMaxs(),
+			MASK_PLAYERSOLID, this, COLLISION_GROUP_PLAYER_MOVEMENT, tr ) )
+	{
+		pPhysics->SetPosition( GetAbsOrigin(), vec3_angle, true );
+		m_oldOrigin = GetAbsOrigin();
+		return;
+	}
+
+	BaseClass::VPhysicsShadowUpdate( pPhysics );
+}
