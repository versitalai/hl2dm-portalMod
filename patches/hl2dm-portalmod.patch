+		return &pPickup->GetGrabController();
+
+	CWeaponPhysCannon *pCannon = dynamic_cast<CWeaponPhysCannon *>( pPlayer->GetActiveWeapon() );
+	if ( pCannon && pCannon->GetGrabController().GetAttached() )
+	{
+		*ppCannon = pCannon;
+		return &pCannon->GetGrabController();
+	}
+	return NULL;
+}
+
+static void PortalHoldFailed( CBasePlayer *pPlayer, CWeaponPhysCannon *pCannon )
+{
+	// Only when the portal chain gets deeper than we track.
+	if ( pCannon )
+		pCannon->ForceDrop();
+	else
+		pPlayer->ForceDropOfCarriedPhysObjects( NULL );
+}
+
+bool PhysCannon_GetHeldObjectTarget( CBaseEntity *pObject, Vector *pTarget )
+{
+	for ( int i = 1; i <= gpGlobals->maxClients; i++ )
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex( i );
+		if ( !pPlayer )
+			continue;
+
+		CWeaponPhysCannon *pCannon;
+		CGrabController *pController = GetPlayerGrabController( pPlayer, &pCannon );
+		if ( pController && pController->GetAttached() == pObject )
+		{
+			*pTarget = pController->GetTargetPosition();
+			return true;
+		}
+	}
+	return false;
+}
+
+void PhysCannon_HeldObjectWentThroughPortal( CBaseEntity *pObject, CHL2MPPortal *pPortal )
+{
+	for ( int i = 1; i <= gpGlobals->maxClients; i++ )
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex( i );
+		if ( !pPlayer )
+			continue;
+
+		CWeaponPhysCannon *pCannon;
+		CGrabController *pController = GetPlayerGrabController( pPlayer, &pCannon );
+		if ( !pController || pController->GetAttached() != pObject )
+			continue;
+
+		if ( !pController->OnAttachedWentThroughPortal( pPortal ) )
+		{
+			PortalHoldFailed( pPlayer, pCannon );
+			continue;
+		}
+		if ( pCannon )
+			pCannon->m_nHeldPortalCount = pController->GetPortalCount();
+	}
+}
+
+void PhysCannon_HolderWentThroughPortal( CBasePlayer *pPlayer, CHL2MPPortal *pPortal )
+{
+	CWeaponPhysCannon *pCannon;
+	CGrabController *pController = GetPlayerGrabController( pPlayer, &pCannon );
+	if ( !pController )
+		return;
+
+	if ( !pController->OnHolderWentThroughPortal( pPortal ) )
+	{
+		PortalHoldFailed( pPlayer, pCannon );
+		return;
+	}
+	if ( pCannon )
+		pCannon->m_nHeldPortalCount = pController->GetPortalCount();
+}
+#endif
